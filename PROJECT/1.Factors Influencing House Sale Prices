--Characteristics of five most expensive houses
SELECT 
    bedrooms,
    bathrooms,
    grade,
    condition,
    waterfront,
    sqft_living,
    sqft_lot,
    floors,
    sqft_above,
    sqft_basement,
    yr_built,
    Price
FROM house_price
ORDER BY Price DESC
LIMIT 5;

--What are the factors that influence the house sale price?
--Grade 
SELECT
  grade,
  count(*) as house_count,
  ROUND(min(price),2 )as min_price,
  ROUND(max(price),2 )as max_price,
  ROUND(AVG(price),2) as avg_price
FROM
  house_price
Group BY grade 
ORDER BY avg_price DESC;

